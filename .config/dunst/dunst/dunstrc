# Nord-themed dunst configuration
# Derived from EndeavourOS i3
# Palette: https://www.nordtheme.com/
#   nord0 #2E3440  nord1 #3B4252  nord2 #434C5E  nord3 #4C566A
#   nord4 #D8DEE9  nord5 #E5E9F0  nord6 #ECEFF4
#   nord7 #8FBCBB  nord8 #88C0D0  nord9 #81A1C1  nord10 #5E81AC
#   nord11 #BF616A nord12 #D08770 nord13 #EBCB8B nord14 #A3BE8C nord15 #B48EAD
# See dunst(5) for all configuration options

[global]
    ### Display ###
    monitor = DP-1

    follow = none

    ### Geometry ###
    width = 360

    # dynamic height from 0 to 300
    # The maximum height of a single notification, excluding the frame.
    height = (0, 300)

    # Position the notification in the top right corner
    origin = top-right

    # Offset from the origin
    offset = (12, 12)

    # Scale factor. It is auto-detected if value is 0.
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 3
    progress_bar_corners = all
    icon_corner_radius = 3
    icon_corners = all
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#5E81AC"
    gap_size = 0
    separator_color = auto
    sort = yes
    idle_threshold = 0

    ### Text ###
    font = Noto Sans Regular 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no

    ### Icons ###
    icon_position = left
    min_icon_size = 0
    max_icon_size = 36
    icon_path = /usr/share/icons/Qogir/16/status:/usr/share/icons/Qogir/16/devices/:/usr/share/icons/Qogir/24/panel/:/usr/share/icons/Qogir/16/apps/:/usr/share/pixmaps/:/usr/share/icons/Qogir/scalable/apps/

    ### History ###
    sticky_history = false
    history_length = 0

    ### Misc/Advanced ###
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 3
    corners = all
    ignore_dbusclose = false

    ### Legacy
    force_xinerama = false

    ### mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false


# ── Urgency levels (Nord) ──────────────────────────────────────────────────────
[urgency_low]
    # Polar night background, snow storm text, frost border
    background = "#2E3440EE"
    foreground = "#D8DEE9"
    frame_color = "#4C566A"
    timeout = 5
    icon = /usr/share/icons/Qogir/16/status/package-installed-outdated.svg

[urgency_normal]
    # Slightly lighter polar night, snow storm text, frost blue border
    background = "#3B4252EE"
    foreground = "#ECEFF4"
    frame_color = "#88C0D0"
    timeout = 8
    override_pause_level = 30
    icon = /usr/share/icons/Qogir/16/emblems/emblem-question.svg

[urgency_critical]
    # Same base, red aurora border + text accent for emphasis
    background = "#3B4252EE"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    timeout = 120
    icon = /usr/share/icons/Qogir/16/actions/dialog-warning.svg

[stack-volumes]
    appname = "some_volume_notifiers"
    set_stack_tag = "volume"
