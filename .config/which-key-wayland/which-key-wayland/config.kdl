// which-key-wayland configuration — mirrors hyprland.lua binds (plan §11)
//
// Leader key is bound in hyprland.lua:  bind SUPER+/ -> exec which-key-wayland
//   => press Super+/ to open this panel.
//
// Model (same as which-key.nvim): the leader modifier is pressed ONCE to open the
// panel; the leaf keys below are then pressed WITHOUT re-pressing Super. So a
// Hyprland bind of `Super+J` (focus left) maps to panel key `j`, and
// `Super+Shift+J` (move window left) maps to panel key `J` (= Shift+j).
//
// Hyprland 0.55 moved `hyprctl dispatch` to Lua syntax: the arg is a Lua
// expression evaluating to a dispatcher function, passed to hl.dispatch.
// `hyprctl dispatch 'EXPR'` is shorthand for `hyprctl eval 'hl.dispatch(EXPR)'`.
// Built-in dispatchers live under hl.dsp.* (e.g. hl.dsp.focus({workspace=N}));
// hy3 plugin dispatchers live under hl.plugin.hy3.* (colons in the legacy
// hy3:* names broke under the Lua evaluator, so the typed API is required).
// These actions run independently of hyprland.lua — the two files are
// maintained in parallel (plan §11.2 caveat).
//
// Built-in navigation (hardcoded, not bindable here): Esc = back/close,
// Ctrl+u = page up, Ctrl+d = page down.

timeout 2500 // ms before panel auto-hides; 0 to disable

font {
    size 16.0
    line-height 20.0
}

// Nord-derived palette to match the Hyprland active-border theme in hyprland.lua.
color {
    fg-key "#D8DEE9"
    fg-separator "#4C566A"
    fg-action "#88C0D0"
    fg-group "#5E81AC"
    bg "#2E3440"
}

layout {
    width 520
    max-items 12
    padding 4
    radius 8
    anchor 2 // 1:tr | 2:br | 3:bl | 4:tl
    margin {
        top 0
        right 12
        bottom 12
        left 0
    }
}

bind {
    // ── Direct actions ────────────────────────────────────────────────
    Return desc="Terminal" { spawn "alacritty"; }
    o desc="File manager (Dolphin)" { spawn "dolphin"; }
    d desc="Launcher (rofi)" { sh "rofi -modi drun,run -show drun"; }
    e desc="Session / power menu" { sh "rofi -show power-menu -modi 'power-menu:rofi-power-menu --choices=lockscreen/logout/suspend/reboot/shutdown'"; }
    s desc="Screenshot" { sh "hyprshot -m output"; }
    q desc="Kill window" { sh "hyprctl dispatch 'hl.plugin.hy3.kill_active()'"; }
    r desc="Resize mode" { sh "hyprctl dispatch 'hl.dsp.submap(\"resize\")'"; }
    c desc="Reload Hyprland config" { sh "hyprctl reload"; }

    // ── Workspaces (switch) ──────────────────────────────────────────
    1 desc="Workspace 1" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"; }
    2 desc="Workspace 2" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"; }
    3 desc="Workspace 3" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"; }
    4 desc="Workspace 4" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"; }
    5 desc="Workspace 5" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"; }
    6 desc="Workspace 6" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"; }
    7 desc="Workspace 7" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"; }
    8 desc="Workspace 8" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"; }
    9 desc="Workspace 9" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"; }
    0 desc="Workspace 10" { sh "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'"; }

    // ── Window group ─────────────────────────────────────────────────
    w desc="Window" {
        // Focus movement (vim-style j/k/l/;) — hy3 move_focus for node-tree nav
        j desc="Focus left" { sh "hyprctl dispatch 'hl.plugin.hy3.move_focus(\"l\")'"; }
        k desc="Focus down" { sh "hyprctl dispatch 'hl.plugin.hy3.move_focus(\"d\")'"; }
        l desc="Focus up" { sh "hyprctl dispatch 'hl.plugin.hy3.move_focus(\"u\")'"; }
        ; desc="Focus right" { sh "hyprctl dispatch 'hl.plugin.hy3.move_focus(\"r\")'"; }

        // Move window (Shift + key) — hy3 move_window
        J desc="Move left" { sh "hyprctl dispatch 'hl.plugin.hy3.move_window(\"l\")'"; }
        K desc="Move down" { sh "hyprctl dispatch 'hl.plugin.hy3.move_window(\"d\")'"; }
        L desc="Move up" { sh "hyprctl dispatch 'hl.plugin.hy3.move_window(\"u\")'"; }
        : desc="Move right" { sh "hyprctl dispatch 'hl.plugin.hy3.move_window(\"r\")'"; }

        // Split / layout — hy3 make_group / change_group
        h desc="Split horizontal" { sh "hyprctl dispatch 'hl.plugin.hy3.make_group(\"h\")'"; }
        v desc="Split vertical" { sh "hyprctl dispatch 'hl.plugin.hy3.make_group(\"v\")'"; }
        t desc="Toggle tabbed" { sh "hyprctl dispatch 'hl.plugin.hy3.change_group(\"toggletab\")'"; }
        x desc="Toggle split orientation" { sh "hyprctl dispatch 'hl.plugin.hy3.change_group(\"opposite\")'"; }
        f desc="Fullscreen" { sh "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"maximized\" })'"; }

        // Focus parent / child — hy3 change_focus
        a desc="Focus parent" { sh "hyprctl dispatch 'hl.plugin.hy3.change_focus(\"raise\")'"; }
        g desc="Focus child" { sh "hyprctl dispatch 'hl.plugin.hy3.change_focus(\"lower\")'"; }
    }

    // ── Move window to workspace ─────────────────────────────────────
    m desc="Move to workspace" {
        1 desc="→ ws 1" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 1 })'"; }
        2 desc="→ ws 2" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 2 })'"; }
        3 desc="→ ws 3" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 3 })'"; }
        4 desc="→ ws 4" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 4 })'"; }
        5 desc="→ ws 5" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 5 })'"; }
        6 desc="→ ws 6" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 6 })'"; }
        7 desc="→ ws 7" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 7 })'"; }
        8 desc="→ ws 8" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 8 })'"; }
        9 desc="→ ws 9" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 9 })'"; }
        0 desc="→ ws 10" { sh "hyprctl dispatch 'hl.dsp.window.move({ workspace = 10 })'"; }
    }

    // NOTE: hyprland.lua also binds togglefloating ($mod+Shift+space) and
    // hy3:togglefocuslayer ($mod+space). These use the Space key, which
    // which-key-wayland does not expose as a bindable printable key, so they
    // are intentionally omitted here — invoke them directly via the Super
    // bind instead of through this panel.
}
